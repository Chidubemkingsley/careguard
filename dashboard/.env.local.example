# =============================================================================
# CareGuard Dashboard Environment Configuration
# =============================================================================
# Copy to .env.local and fill in your values: cp .env.local.example .env.local

# --- Backend API Connection ---
# Base URL for the CareGuard unified backend server.
# Local dev: http://localhost:3004
# Production / Vercel deployment: https://your-app.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3004

# Optional Bearer token for authenticating dashboard requests to the backend server.
# Set if AGENT_API_KEY or CAREGIVER_TOKEN is configured on the server.
# NEXT_PUBLIC_AGENT_API_KEY=

# --- Stellar Network ---
# Target Stellar network label ('testnet' or 'public').
# Used to derive explorer links and network status badges in the UI.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# --- Sentry Error Tracking (optional) ---
# Client-exposed Sentry DSN for front-end error tracking and performance monitoring.
# Documented as optional client-exposed value; server-side Express code uses SENTRY_DSN in the root .env.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
